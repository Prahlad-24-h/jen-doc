pipeline {

    agent any

    stages {

        

        stage('Test') {
            steps {
                sh 'pytest test.py -v'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my-python-app .'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run --rm my-python-app'
            }
        }
    }

    post {
        success {
            echo 'Docker Jenkins pipeline completed successfully!'
        }

        failure {
            echo 'Docker Jenkins pipeline failed!'
        }
    }
}
